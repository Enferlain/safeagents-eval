# Exact publication allowlist. New files require deliberate review.
# Exclusions do not delete or relocate local data.
/*
!/.gitattributes
!/.github/
!/.gitignore
!/CHANGELOG.md
!/INTERN_ADAPTER.md
!/LICENSE
!/NOTICE
!/README.md
!/REPORT.md
!/THIRD_PARTY_NOTICES.md
!/analyze.py
!/dataset-provenance.json
!/docs/
!/intern_adapter.py
!/intern_runner.py
!/licenses/
!/page/
!/pyproject.toml
!/references/
!/requirements-intern-windows.txt
!/run.py
!/scripts/
!/test_intern.py
!/test_metrics.py
!/test_reporting.py
!/tests/
!/trial/
!/uv.lock
!/validate_intern_runtime.py
!/xaab/

/.github/*
!/.github/workflows/

/docs/*
!/docs/BENCHMARKS.md
!/docs/DEVELOPMENT.md

/licenses/*
!/licenses/SOURCES.json
!/licenses/intern/
!/licenses/page/

/page/*
!/page/analysis_metrics.py
!/page/analyze.py
!/page/prepare.py
!/page/run_model.py
!/page/runner.py
!/page/test_analysis.py
!/page/test_runner.py

/references/*
!/references/sources.json

/scripts/*
!/scripts/check.py

/tests/*
!/tests/test_repository.py

/trial/*
!/trial/OBSERVATION.md
!/trial/SECURITY_APP.md
!/trial/decision_models.py
!/trial/fake_model.py
!/trial/judge-policy-benchmark.txt
!/trial/judge_adapter.py
!/trial/observation.py
!/trial/observe.py
!/trial/replay_model.py
!/trial/replay_qev.py
!/trial/security-plugin/
!/trial/smoke_judge.py
!/trial/test_decision_models.py
!/trial/test_judge_adapter.py
!/trial/test_judge_models.py
!/trial/test_observation_store.py
!/trial/test_observe.py
!/trial/test_replay_model.py
!/trial/test_security_models.py
!/trial/test_security_service.py
!/trial/test_security_telemetry.py
!/trial/test_security_ui.mjs
!/trial/verify_e2e.py
!/trial/verify_hermes_routes.py
!/trial/verify_judge_live.py
!/trial/verify_observation.py
!/trial/verify_routes.py

/xaab/*
!/xaab/README.md
!/xaab/analyze_comparison.py
!/xaab/run_comparison.py
!/xaab/runner.py
!/xaab/test_runner.py

/.github/workflows/*
!/.github/workflows/ci.yml

/licenses/intern/*
!/licenses/intern/Intern-Decision-0.8B-LICENSE-QWEN.txt
!/licenses/intern/Intern-Decision-0.8B-LICENSE.txt
!/licenses/intern/Intern-Decision-2B-LICENSE-QWEN.txt
!/licenses/intern/Intern-Decision-2B-LICENSE.txt

/licenses/page/*
!/licenses/page/LICENSE.txt
!/licenses/page/NOTICE.txt

/trial/security-plugin/*
!/trial/security-plugin/__init__.py
!/trial/security-plugin/dashboard/
!/trial/security-plugin/desktop/
!/trial/security-plugin/identity.py
!/trial/security-plugin/plugin.yaml
!/trial/security-plugin/service.py
!/trial/security-plugin/telemetry.py

/trial/security-plugin/dashboard/*
!/trial/security-plugin/dashboard/manifest.json
!/trial/security-plugin/dashboard/plugin_api.py

/trial/security-plugin/desktop/*
!/trial/security-plugin/desktop/plugin.js

# Defense in depth for credentials, generated files and runtime stores.
.env
.env.*
.secrets
*.pem
*.key
id_rsa
id_ed25519
*.gguf
*.safetensors
*.bin
*.log
*.jsonl
*.pyc
*.pre-observation
__pycache__/
.venv*/
.uv-cache*/
.ruff_cache/
.pytest_cache/
trial/private-observation/
trial/observation-verification/
trial/journal.jsonl
trial/local-journal.jsonl
trial/logs/
trial/upstream/
